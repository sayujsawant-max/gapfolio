# --- core ---
GAPFOLIO_ENV=production
GAPFOLIO_SECRET_KEY=generate-with-openssl-rand-hex-32
GAPFOLIO_DATABASE_URL=postgresql+psycopg://gapfolio:gapfolio@db:5432/gapfolio

# --- models ---
GAPFOLIO_ANTHROPIC_API_KEY=
GAPFOLIO_ANTHROPIC_MODEL=claude-sonnet-4-6

# onnx (local model via ONNX Runtime, ~170 MB, default) | sbert (PyTorch, ~590 MB) | voyage | openai | hash (tests only)
GAPFOLIO_EMBEDDING_PROVIDER=onnx
GAPFOLIO_SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
GAPFOLIO_EMBEDDING_DIM=384
# remote providers only:
GAPFOLIO_EMBEDDING_API_KEY=
GAPFOLIO_EMBEDDING_MODEL=voyage-3

# --- privacy ---
GAPFOLIO_RETENTION_DAYS=365
GAPFOLIO_CONSENT_VERSION=2026-08-v1

# --- public deployment ---
# Serve the built React app from this API (one origin, one URL).
GAPFOLIO_SERVE_UI=true
GAPFOLIO_CORS_ORIGINS=http://localhost:5173
GAPFOLIO_RATE_LIMIT_GENERAL=120
GAPFOLIO_RATE_LIMIT_HEAVY=12
# Placement-officer accounts can only be created with this code; empty = disabled.
GAPFOLIO_OFFICER_INVITE_CODE=
